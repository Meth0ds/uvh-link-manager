# Environment for the production boot contract (docker-compose.release-boot.yml).
#
# These credentials are fictitious fixtures. They are formally valid so that
# ProductionSecurity accepts them, and they carry no authority outside this
# isolated stack: every host is .localhost or .invalid, and no value grants
# access to a real account, database or provider.
#
# Keep this file as the single source of truth. The positive and negative cases
# both read it, and each negative case overrides exactly one variable, so a
# failure can only be attributed to the invariant under test.
#
# Values matter as much as names here. APP_SECRET and EDGE_ASK_SECRET must not
# contain the placeholder words the gate rejects on purpose, so nothing below
# may be written as a readable token such as "changeme": a placeholder would
# fail the positive case and hide the invariant that case is meant to prove.

APP_NAME=UVH
APP_ENV=production
APP_DEBUG=false
# 32 zero bytes, base64 encoded. Accepted by the gate because it is a valid
# cipher key, even though nothing sensitive is protected by it.
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_SECRET=zQ8m3Xr7Kp2Vn5Bt9Wd4Ls6Yh1Jc0Fg3Ra8Ue2Tq5Nb7Mi4
APP_SECRET_PREVIOUS=
APP_SECRET_ROTATION_UNTIL=
APP_URL=https://app.uvh.localhost
APP_HOST=app.uvh.localhost
PUBLIC_HOST=uvh.localhost
PUBLIC_ORIGIN=https://uvh.localhost
METRICS_BEARER_TOKEN=mK4nR8tW2yB6dF1gH5jL9pQ3sV7xZ0cN4aE8uI2oP6kM9vX3bT7wY1rD5fG8hJ

# The production gate rejects placeholder legal identities, so these must look
# like a completed disclosure. They name no real company.
LEGAL_ENTITY_NAME=UVH Servicios Digitales Sociedad Limitada
LEGAL_TAX_ID=B12345678
LEGAL_ADDRESS=Calle de la Prueba 12, 28013 Madrid, Espana
LEGAL_REGISTRY_DETAILS=Registro Mercantil de Madrid, Tomo 1, Folio 1, Hoja M-123456
LEGAL_HOSTING_PROVIDER=Proveedor Europeo de Infraestructura Sociedad Anonima
LEGAL_HOSTING_REGION=Comunidad de Madrid, Espana

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=uvh_release_boot_test
DB_USERNAME=uvh_release_boot
DB_PASSWORD=uvh-release-boot-db-credential
# Production refuses to boot without verified database TLS, which is why this
# stack has to terminate PostgreSQL with a certificate at all.
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/ca/ca.crt

# Redis is the production store for cache, rate limits, locks and queues, so
# the boot contract has to exercise that path rather than the database one.
CACHE_STORE=redis
# The rate limiter keeps its own store with a shared fallback, which is what
# lets public traffic keep being served while Redis is unreachable.
CACHE_LIMITER=failover
CACHE_FAILOVER_STORES=redis,database
# Credential limiters count on a single shared store of their own, never on the
# chain above: for them a second backend is a second, empty window rather than a
# fallback. The gate rejects an empty value, Redis and failover here, so a
# fixture that omits this key cannot boot at all — which is how this line was
# missing without anyone noticing that the positive case had stopped passing.
CACHE_LIMITER_SECURITY=database
QUEUE_CONNECTION=redis
# The Redis queue driver does not inherit DB_QUEUE_RETRY_AFTER: without this it
# takes the framework default (90 s), below the range the gate accepts. One
# negative case mutates this value to prove the gate catches it.
REDIS_QUEUE_RETRY_AFTER=300
QUEUE_FAILED_DRIVER=database-uuids

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
# "redis" is part of the hostname, not of this secret: the gate rejects
# placeholder words, so the password must not read like one.
REDIS_PASSWORD=uvh-release-boot-redis-secret-01
REDIS_PREFIX=uvh-
REDIS_DB=0
REDIS_CACHE_DB=1
CACHE_PREFIX=uvh-cache-

SESSION_DRIVER=database
SESSION_COOKIE=__Host-uvh_session
CSRF_COOKIE=__Host-uvh_csrf
# The parked-credential cookies carry the same __Host- prefix as the session:
# Secure, Path=/ and no Domain. The gate rejects the bare defaults, so these two
# cannot be left out of the fixture.
PENDING_INVITATION_COOKIE=__Host-uvh_pending_invitation
PENDING_INTENT_COOKIE=__Host-uvh_pending_intent
# El secreto que autoriza corregir un registro sin verificar entra en la misma
# regla que las demás, y su techo de vida lo valida el gate.
REGISTRATION_EDIT_COOKIE=__Host-uvh_registration_edit
REGISTRATION_EDIT_TTL_HOURS=24
# Must stay empty: production isolates app.uvh.es by refusing a shared domain.
COOKIE_DOMAIN=
COOKIE_SECURE=true
HSTS_ENABLED=true
SESSION_TTL_DAYS=30
ADMIN_MFA_FRESH_MINUTES=15

DOMAIN_VERIFICATION_FRESH_HOURS=24
DOMAIN_REVALIDATION_HOURS=24
DOMAIN_FAILURE_RETRY_HOURS=1
DOMAIN_FAILURE_GRACE_HOURS=2
DOMAIN_MAX_FAILURES=3
CUSTOM_DOMAIN_CNAME_TARGET=cname.uvh-cdn.net
EDGE_ASK_SECRET=pV7nQ2xK9mL4tR8sW3yB6cD1fG5hJ0zA2eS4uH7kN9qM3vX6bZ1wY8rT5pL2dF4g
ACME_EMAIL=ops@uvh.es
EDGE_INTERNAL_HOST=edge
# Both networks are pinned to 172.28.0.0/24 by the stack, so the proxy and edge
# allowlists describe the addresses the containers actually use.
EDGE_INTERNAL_CIDRS=172.28.0.0/24
TRUSTED_PROXIES=172.28.0.0/24
TRUST_COUNTRY_HEADER=false

# A transport that really delivers: the gate refuses log/array outside local.
MAIL_MAILER=smtp
MAIL_HOST=smtp.uvh.invalid
MAIL_PORT=587
MAIL_FROM_ADDRESS=no-reply@uvh.es
MAIL_FROM_NAME=UVH

SESSION_PURGE_DAYS=30
LINK_TRASH_DAYS=30
TOKEN_PURGE_DAYS=7
API_TOKEN_PURGE_DAYS=30
DELIVERY_PURGE_DAYS=90
FAILED_JOB_PURGE_DAYS=30
MAIL_OUTBOX_PURGE_DAYS=30
ACCOUNT_RECOVERY_PURGE_DAYS=90
OPERATIONAL_METRICS_PURGE_DAYS=30
PRIVACY_REQUEST_PURGE_DAYS=1095
EXPORT_PURGE_DAYS=7
AUDIT_PURGE_DAYS=365
ANALYTICS_RETENTION_DAYS=180
HOUSEKEEPING_INTERVAL_MINUTES=60

AUTH_LIMIT=10
REGISTER_LIMIT=10
LINK_CREATE_LIMIT=30
RESOLVE_LIMIT=600
API_TOKEN_LIMIT=600

# Formally valid and distinct, but not issued by hCaptcha. The gate only
# rejects the documented test keys and obvious placeholders.
HCAPTCHA_SITE_KEY=10000000-aaaa-4aaa-8aaa-aaaaaaaaaaaa
HCAPTCHA_SECRET=0x1111111111111111111111111111111111111111
HCAPTCHA_PUBLIC_SITE_KEY=20000000-bbbb-4bbb-8bbb-bbbbbbbbbbbb
HCAPTCHA_PUBLIC_SECRET=0x2222222222222222222222222222222222222222
HCAPTCHA_CONNECT_TIMEOUT=2
HCAPTCHA_TIMEOUT=5
HCAPTCHA_DEV_FALLBACK=false
