# Bases fijadas por digest conservando la etiqueta: el artefacto que se
# despliega tiene que ser el revisado, no «lo que esa etiqueta signifique hoy».
# Dependabot mantiene la etiqueta al día y `scripts/check-image-digests.mjs`
# comprueba en CI que el digest sigue resolviendo.
FROM node:25-bookworm-slim@sha256:81db02c4b671288a03915da9534dbd54f96d0e7c24d80ccc54f5b36b2e684370 AS frontend

WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend ./
COPY shared/localisation /build/shared/localisation
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.31-alpine@sha256:b5047b9b76845eac124358373c6852377c52e4b05834a47647e955dd91cb8f1e

COPY --from=frontend /build/frontend/dist/uvh/nginx /etc/nginx/templates/localisation
COPY docker/nginx/uvh.conf.template /etc/nginx/templates/default.conf.template
COPY --chmod=755 docker/nginx/production-entrypoint.sh /usr/local/bin/uvh-nginx-entrypoint
COPY --from=frontend /build/frontend/dist/uvh/browser /usr/share/nginx/html
# Fixed same-origin assets and immutable legal archives keep their old URLs.
COPY --from=frontend /build/frontend/public /usr/share/nginx/html

# La imagen base es `nginx-unprivileged`, que ya arranca como uid 101. Se
# declara aquí de forma explícita para que el usuario no dependa de un detalle
# de la imagen base: si una versión futura volviera a root, el cambio se vería
# en la revisión en lugar de aparecer en producción.
USER 101:101

ENTRYPOINT ["/usr/local/bin/uvh-nginx-entrypoint"]

# La base declara `CMD ["nginx", "-g", "daemon off;"]`, pero declarar un
# `ENTRYPOINT` en una imagen hija vacía el `CMD` heredado: sin esta línea el
# contenedor no recibía ningún argumento, el entrypoint terminaba en un `exec`
# vacío y el proceso salía con código 0 en menos de un segundo. Ni Compose ni la
# puerta de CI lo notaban, porque un contenedor que sale «bien» no es un fallo
# para ninguno de los dos. Se repite aquí de forma explícita, en vez de
# heredarla, para que la imagen no dependa de lo que declare la base.
CMD ["nginx", "-g", "daemon off;"]
