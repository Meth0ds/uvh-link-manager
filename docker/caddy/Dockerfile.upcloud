FROM caddy:2.11.7-builder-alpine@sha256:aa705b1e8e4bce41a7a30de934c1e00f6821667c1d1206424465065c92cb7674 AS builder
RUN xcaddy build v2.11.7 \
    --with github.com/caddy-dns/cloudflare@a8737d095ad5a48ca031cea6ab704057dbc2d250 \
    --replace golang.org/x/net=golang.org/x/net@v0.60.0

FROM alpine:3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
ENV XDG_CONFIG_HOME=/config XDG_DATA_HOME=/data
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
COPY --chmod=755 docker/caddy/upcloud-entrypoint.sh /usr/local/bin/uvh-caddy-entrypoint
COPY docker/caddy/Caddyfile.upcloud /etc/caddy/Caddyfile
COPY docker/caddy/access-operator.caddy.example /etc/caddy/access-operator.caddy
RUN apk upgrade --no-cache zlib \
    && apk add --no-cache ca-certificates \
    && mkdir -p /data/caddy /config/caddy /srv \
    && addgroup -S -g 10001 uvh \
    && adduser -S -D -u 10001 -G uvh uvh \
    && chown -R uvh:uvh /data /config
USER 10001:10001
WORKDIR /srv
ENTRYPOINT ["/usr/local/bin/uvh-caddy-entrypoint"]
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
