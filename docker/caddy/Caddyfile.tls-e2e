{
	email {$ACME_EMAIL}
	admin off

	# The E2E certificate authority: a local Pebble instance, trusted through
	# its Mini CA. Everything else below mirrors the production Caddyfile — the
	# on-demand ask gate, the per-request re-authorization and the upstream
	# shape — so the TLS chain exercises the real edge path end to end.
	acme_ca https://pebble:14000/dir
	acme_ca_root /certs/pebble.minica.pem

	on_demand_tls {
		ask http://edge-ask-shim:8081/internal/caddy/ask
	}
}

(uvh_upstream) {
	header -Server
	reverse_proxy app:8000 {
		# Keep the original hostname so Laravel can enforce tenant/domain
		# isolation and answer with the branded health surface.
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}

		transport http {
			dial_timeout 3s
			response_header_timeout 70s
			keepalive 30s
		}
	}
}

# Customer hostnames are admitted only by the indexed ask endpoint — during
# issuance and again on every request, so a disabled or deleted domain stops
# routing even while Caddy still holds a cached certificate.
https:// {
	tls {
		on_demand
	}
	route {
		forward_auth edge-ask-shim:8081 {
			uri /internal/caddy/ask?domain={host}
		}
		import uvh_upstream
	}
}

http:// {
	# The same authorization protects the plaintext redirect, exactly like
	# production: an arbitrary Host must never be reflected into Location.
	route {
		forward_auth edge-ask-shim:8081 {
			uri /internal/caddy/ask?domain={host}
		}
		redir https://{host}{uri} 308
	}
}
