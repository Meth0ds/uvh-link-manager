# Copy to /etc/uvh/mailu.env with mode 0600; never publish the real values.
# Mailu 2024.06 / Roundcube, with authenticated Resend outbound SMTP.
SECRET_KEY=
SUBNET=172.31.0.0/24
DOMAIN=uvh.es
HOSTNAMES=mail.uvh.es
POSTMASTER=legal
TLS_FLAVOR=cert
TLS_CERT_FILENAME=cert.pem
TLS_KEYPAIR_FILENAME=key.pem
DISABLE_STATISTICS=True
ADMIN=true
WEBMAIL=roundcube
API=false
WEBDAV=none
ANTIVIRUS=clamav
SCAN_MACROS=false
FETCHMAIL_ENABLED=False
FULL_TEXT_SEARCH=es,en
FULL_TEXT_SEARCH_ATTACHMENTS=False
MESSAGE_SIZE_LIMIT=25000000
MESSAGE_RATELIMIT=100/day
AUTH_RATELIMIT_IP=20/hour
AUTH_RATELIMIT_USER=100/day
CREDENTIAL_ROUNDS=12
RELAYNETS=
RELAYHOST=[smtp.resend.com]:587
RELAYUSER=resend
RELAYPASSWORD=
OUTBOUND_TLS_LEVEL=secure
RECIPIENT_DELIMITER=+
DMARC_RUA=legal
DMARC_RUF=legal
WELCOME=false
COMPRESSION=zstd
COMPRESSION_LEVEL=6
WEBROOT_REDIRECT=/webmail
WEB_ADMIN=/admin
WEB_WEBMAIL=/webmail
WEB_API=/api
SITENAME=UVH Correo
WEBSITE=https://uvh.es
REAL_IP_HEADER=X-Real-IP
REAL_IP_FROM=172.29.0.2/32
REJECT_UNLISTED_RECIPIENT=yes
LOG_LEVEL=WARNING
TZ=Europe/Madrid
DEFAULT_SPAM_THRESHOLD=80
