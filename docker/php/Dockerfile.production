# Bases fijadas por digest con la etiqueta a la vista: la etiqueta dice qué
# release es, el digest qué bytes son. Dependabot propone la actualización y
# `scripts/check-image-digests.mjs` verifica en CI que el digest sigue
# resolviendo y avisa si la etiqueta ya apunta a otro sitio.
FROM composer:2@sha256:aaeab4b6b031e0a88efb907f0f26b563532a644fc2f4ea0d000ecf8658f7a2b8 AS vendor

WORKDIR /build
COPY backend-laravel/composer.json backend-laravel/composer.lock ./
# `ext-intl` and `ext-gd` are exempted only in this dependency-install stage:
# the composer base lacks these extensions and their compiler toolchain, while the
# runtime image below does compile it and the entrypoint refuses to boot when it
# is missing. Without this exemption the lockfile cannot be installed at all — the
# stage aborted with "requires PHP extension ext-intl * but it is missing", and
# every production build (compose, release smoke, boot contract) failed with it.
# The gate that matters is the entrypoint's extension assertion, which runs
# before the framework serves anything.
RUN composer install --no-dev --prefer-dist --no-interaction --no-progress --no-scripts \
        --ignore-platform-req=ext-intl --ignore-platform-req=ext-gd
COPY backend-laravel ./
COPY frontend/public/visitor-assets ./resources/visitor-assets
COPY shared/localisation ./resources/localisation
RUN APP_ENV=local \
    APP_DEBUG=false \
    APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= \
    composer dump-autoload --no-dev --classmap-authoritative --no-interaction \
    && php -r 'require "vendor/autoload.php"; if (!class_exists("Resend")) { fwrite(STDERR, "Resend SDK missing from production dependencies\n"); exit(1); }'

FROM php:8.5.10-fpm-bookworm@sha256:cc45fc347dcdef585e907fa7dab27087039f2adf7bd911c22b79a3d80cc98d08
# Security floor for CVE-2026-109618 / CVE-2026-109619 (PHP advisory, 2026-10-21).
# Fail closed if a future base change accidentally reintroduces an older runtime.
RUN php -r 'if (version_compare(PHP_VERSION, "8.4.27", "<")) { fwrite(STDERR, "PHP 8.4.27 or newer required\n"); exit(1); }'

# phpredis is not bundled with PHP, so it is compiled here. The build
# toolchain ($PHPIZE_DEPS) is purged in the same layer: the runtime image must
# not carry a compiler. The last step fails the build rather than the container
# start if the extension did not land, because production requires it.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libcurl4-openssl-dev \
        libicu-dev \
        libpng-dev \
        libjpeg62-turbo-dev \
        libfreetype6-dev \
        libonig-dev \
        libpq-dev \
        libzip-dev \
        $PHPIZE_DEPS \
    && docker-php-ext-configure gd --with-jpeg --with-freetype \
    && docker-php-ext-install -j"$(nproc)" \
        bcmath \
        curl \
        intl \
        gd \
        mbstring \
        opcache \
        pcntl \
        pdo_pgsql \
        pgsql \
        zip \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && pecl clear-cache \
    && apt-get purge -y --auto-remove $PHPIZE_DEPS \
    && php -r 'exit(extension_loaded("redis") ? 0 : 1);' \
    && rm -rf /var/lib/apt/lists/* /tmp/pear

WORKDIR /var/www/html
COPY --from=vendor --chown=www-data:www-data /build ./
COPY --chmod=755 docker/php/production-entrypoint.sh /usr/local/bin/uvh-production-entrypoint
COPY docker/php/uvh-production.ini /usr/local/etc/php/conf.d/zz-uvh-production.ini
RUN mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

ENV APP_CONFIG_CACHE=/tmp/uvh-config.php

USER www-data
ENTRYPOINT ["/usr/local/bin/uvh-production-entrypoint"]
CMD ["php-fpm", "-F"]
