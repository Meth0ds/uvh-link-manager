{
  "name": "uvh-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint \"src/**/*.{ts,html}\" \"e2e/**/*.{ts,mjs}\" playwright.config.ts playwright.release.config.ts --max-warnings=0",
    "pree2e": "node e2e/prepare.mjs",
    "e2e": "playwright test",
    "prerelease:e2e": "node e2e/prepare-release.mjs",
    "release:e2e": "playwright test --config playwright.release.config.ts",
    "e2e:install": "playwright install chromium",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "dependencies": {
    "@angular/animations": "~22.1.5",
    "@angular/cdk": "~22.1.2",
    "@angular/common": "~22.1.5",
    "@angular/compiler": "~22.1.5",
    "@angular/core": "~22.1.5",
    "@angular/forms": "~22.1.5",
    "@angular/material": "~22.1.2",
    "@angular/platform-browser": "~22.1.5",
    "@angular/platform-browser-dynamic": "~22.1.5",
    "@angular/router": "~22.1.5",
    "@fontsource/manrope": "5.3.0",
    "material-icons": "1.13.14",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.3",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.1.7",
    "@angular/cli": "~22.1.4",
    "@angular/compiler-cli": "~22.1.5",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "angular-eslint": "^22.2.0",
    "eslint": "^10.10.0",
    "globals": "17.12.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "5.8.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "overrides": {
    "fast-uri": "3.1.7",
    "less": "4.9.1",
    "qs": "6.16.0"
  }
}
