{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "uvh": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/uvh",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "@angular/localize/init",
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.scss"
            ],
            "scripts": [],
            "allowedCommonJsDependencies": [
              "qrcode",
              "pako"
            ],
            "webWorkerTsConfig": "tsconfig.worker.json",
            "i18nMissingTranslation": "error",
            "localize": true,
            "server": "src/main.server.ts",
            "outputMode": "static"
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": {
                  "inline": false
                }
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "3mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "52kb",
                  "maximumError": "72kb"
                }
              ],
              "outputHashing": "all",
              "localize": [
                "es",
                "en-GB"
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "localize": [
                "es"
              ]
            },
            "design-preview": {
              "browser": "design-preview/main.ts",
              "tsConfig": "design-preview/tsconfig.json",
              "outputPath": "dist/design-preview",
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "server": false,
              "localize": false
            },
            "es": {
              "localize": [
                "es"
              ]
            },
            "en": {
              "localize": [
                "en-GB"
              ]
            },
            "fr": {
              "localize": [
                "fr"
              ]
            },
            "fr-draft": {
              "localize": [
                "fr"
              ],
              "i18nMissingTranslation": "warning"
            },
            "development-es": {
              "server": false,
              "baseHref": "/es/",
              "localize": [
                "es"
              ]
            },
            "development-en": {
              "server": false,
              "baseHref": "/en/",
              "localize": [
                "en-GB"
              ]
            },
            "development-fr": {
              "server": false,
              "baseHref": "/fr/",
              "localize": [
                "fr"
              ],
              "i18nMissingTranslation": "warning"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "uvh:build:production"
            },
            "design-preview": {
              "buildTarget": "uvh:build:design-preview",
              "proxyConfig": "design-preview/proxy.json"
            },
            "development": {
              "buildTarget": "uvh:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "buildTarget": "uvh:build",
            "proxyConfig": "src/proxy.conf.js"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "polyfills": [
              "@angular/localize/init",
              "zone.js",
              "zone.js/testing"
            ]
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "format": "xlf2",
            "outputPath": "src/locale"
          }
        }
      },
      "i18n": {
        "sourceLocale": {
          "code": "es",
          "subPath": "es"
        },
        "locales": {
          "en-GB": {
            "translation": "src/locale/messages.en-GB.xlf",
            "subPath": "en"
          },
          "fr": {
            "translation": "src/locale/messages.fr.xlf",
            "subPath": "fr"
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "cli": {
    "analytics": false
  }
}
