POSTGRES_DB=uvh_local
POSTGRES_USER=uvh_local
POSTGRES_PASSWORD=uvh_local_dev_only
POSTGRES_PORT=5432
ADMINER_PORT=8080
MAILPIT_PORT=8025

# Enable after additive migrations and dedicated destinations workers are ready.
UVH_LINK_WORKFLOWS_ENABLED=false

# App opening is enabled; set either switch to false to disable that modality.
UVH_FEATURE_APP_PROVIDERS=true
UVH_FEATURE_NATIVE_APPS=true

# French stays unpublished until its authored catalogue, mail and legal copies are reviewed.
UVH_FRENCH_ENABLED=true

LOCALISATION_ENABLED=true
