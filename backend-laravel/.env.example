[TEMPLATE]
APP_NAME=UVH
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=uvh_local
DB_USERNAME=uvh_local
DB_PASSWORD=uvh_local_dev_only

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
# Regla de seguridad crítica: sin dominio compartido; nunca ".uvh.es".
SESSION_DOMAIN=
SESSION_COOKIE=uvh_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@uvh.es"
MAIL_FROM_NAME="UVH"

# Secreto de firma de sesión y cifrado at-rest (formato heredado enc:v1:).
# Nunca usar secretos reales en este archivo.
APP_SECRET=