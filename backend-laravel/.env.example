[TEMPLATE]
APP_NAME=UVH
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=uvh_local
DB_USERNAME=uvh_local
DB_PASSWORD=uvh_local_dev_only

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
# Regla de seguridad crítica: sin dominio compartido; nunca ".uvh.es".
SESSION_DOMAIN=
SESSION_COOKIE=uvh_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=240

# Claves oficiales de prueba de hCaptcha. No protegen frente a bots y sólo son
# válidas para desarrollo/test; producción rechaza arrancar con estas claves.
HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000
HCAPTCHA_CONNECT_TIMEOUT=2
HCAPTCHA_TIMEOUT=5

CACHE_STORE=database
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@uvh.es"
MAIL_FROM_NAME="UVH"

# Secreto de firma de sesión y cifrado at-rest (formato heredado enc:v1:).
# Nunca usar secretos reales en este archivo.
APP_SECRET=
# Sólo durante una rotación controlada. La aplicación escribe siempre con
# APP_SECRET y usa estas claves únicamente para leer datos/tokens anteriores.
APP_SECRET_PREVIOUS=
# Debe ser una fecha ISO-8601 futura mientras APP_SECRET_PREVIOUS tenga valor.
APP_SECRET_ROTATION_UNTIL=

# Producción: IPs/CIDR de los proxies TLS autorizados, separadas por comas.
# TRUSTED_PROXIES=10.0.0.10,10.0.0.11
TRUSTED_PROXIES=

# Conservación operativa. Los artefactos de exportación ya caducan a las 24 h;
# esta ventana controla cuánto se conserva su registro terminal de auditoría.
EXPORT_PURGE_DAYS=7
API_TOKEN_PURGE_DAYS=30
MAIL_OUTBOX_PURGE_DAYS=30
ACCOUNT_RECOVERY_PURGE_DAYS=90
