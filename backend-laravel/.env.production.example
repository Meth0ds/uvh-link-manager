APP_NAME=UVH
APP_ENV=production
APP_KEY=
# Base64URL sin padding de al menos 32 bytes aleatorios (43+ caracteres).
APP_SECRET=
# Sólo durante una rotación: claves anteriores Base64URL separadas por comas.
# Vaciar después de ejecutar uvh:crypto:rotate y agotar tokens/jobs antiguos.
APP_SECRET_PREVIOUS=
# Obligatorio y con un máximo de 31 días cuando APP_SECRET_PREVIOUS no esté vacío.
# Ejemplo: 2026-09-10T12:00:00Z
APP_SECRET_ROTATION_UNTIL=
APP_DEBUG=false
APP_URL=https://app.uvh.es
METRICS_BEARER_TOKEN=
APP_HOST=app.uvh.es
PUBLIC_HOST=uvh.es
PUBLIC_ORIGIN=https://uvh.es
LEGAL_ENTITY_NAME=
LEGAL_TAX_ID=
LEGAL_ADDRESS=
LEGAL_REGISTRY_DETAILS=
LEGAL_HOSTING_PROVIDER=
LEGAL_HOSTING_REGION=

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=uvh
DB_USERNAME=uvh
DB_PASSWORD=
DB_SSLMODE=verify-full
# Compose monta aquí el CA PEM del proveedor desde UVH_DB_CA_FILE.
DB_SSLROOTCERT=/run/secrets/uvh_db_ca

# Caché, rate limits, locks y colas salen de PostgreSQL para que la base de datos
# sea la fuente de verdad y no además el bus de mensajes. El limitador de la
# superficie pública escribía una fila con bloqueo exclusivo en cada redirect, y
# la profundidad de la cola competía con las consultas del producto.
#
# `database` sigue siendo válido en un despliegue de un solo nodo; esta plantilla
# describe el stack de docker-compose.production.yml, que además fija estas
# claves en su bloque `environment` (prevalece sobre este archivo) porque es ese
# fichero el que declara el servicio Redis y exige su secreto.
CACHE_STORE=redis
CACHE_LIMITER=failover
# Redis primero y, si no responde, PostgreSQL: la superficie pública sigue
# contando intentos y sirviendo tráfico durante una caída, a costa de volver a
# escribir en la base de datos mientras dure. Los locks NO usan este store:
# mover un lock a otro backend permitiría que dos procesos lo creyeran suyo.
CACHE_FAILOVER_STORES=redis,database
QUEUE_CONNECTION=redis
# El driver de cola de Redis NO hereda DB_QUEUE_RETRY_AFTER: sin esta clave toma
# el valor del framework (90 s), por debajo del timeout de 180 s del worker de
# exportaciones, y un worker podría reclamar un job que otro sigue ejecutando.
REDIS_QUEUE_RETRY_AFTER=240
DB_QUEUE_RETRY_AFTER=240
QUEUE_FAILED_DRIVER=database-uuids

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
# Vacío a propósito: el entrypoint de la imagen lo lee de REDIS_PASSWORD_FILE
# antes de arrancar, así que la contraseña nunca vive en este archivo.
REDIS_PASSWORD=
# Separan este despliegue de cualquier otro que comparta la instancia.
REDIS_PREFIX=uvh-
CACHE_PREFIX=uvh-cache-
# 0 para colas y locks, 1 para caché.
REDIS_DB=0
REDIS_CACHE_DB=1
# Alternativa gestionada: REDIS_URL (admite rediss:// para TLS) en lugar de
# REDIS_HOST/REDIS_PORT. El gate de arranque acepta ambos y rechaza un host de
# loopback, una credencial ausente o de ejemplo, y un limiter no compartido.

SESSION_COOKIE=__Host-uvh_session
CSRF_COOKIE=__Host-uvh_csrf
COOKIE_DOMAIN=
COOKIE_SECURE=true
HSTS_ENABLED=true
SESSION_TTL_DAYS=30
# Administración exige volver a presentar contraseña + MFA tras esta ventana.
ADMIN_MFA_FRESH_MINUTES=15
DOMAIN_VERIFICATION_FRESH_HOURS=24
DOMAIN_REVALIDATION_HOURS=24
DOMAIN_FAILURE_RETRY_HOURS=1
DOMAIN_FAILURE_GRACE_HOURS=2
DOMAIN_MAX_FAILURES=3

# edge.uvh.es debe resolver por A/AAAA al servidor que publica Caddy.
CUSTOM_DOMAIN_CNAME_TARGET=edge.uvh.es
# Secreto Base64URL aleatorio de 32+ bytes, compartido sólo entre Nginx y Laravel.
EDGE_ASK_SECRET=
# Cuenta ACME usada por Caddy para avisos de certificados.
ACME_EMAIL=
EDGE_INTERNAL_HOST=edge
EDGE_INTERNAL_CIDRS=172.29.0.0/24

# Red privada fijada por docker-compose.production.yml. Caddy elimina los
# X-Forwarded-* entrantes y Nginx sólo es accesible dentro de esta red.
TRUSTED_PROXIES=172.29.0.0/24
TRUST_COUNTRY_HEADER=false
COUNTRY_HEADER=cf-ipcountry

MAIL_MAILER=resend
MAIL_FROM_ADDRESS=no-reply@uvh.es
MAIL_FROM_NAME=UVH
RESEND_API_KEY=

SESSION_PURGE_DAYS=30
LINK_TRASH_DAYS=30
TOKEN_PURGE_DAYS=7
API_TOKEN_PURGE_DAYS=30
DELIVERY_PURGE_DAYS=90
FAILED_JOB_PURGE_DAYS=30
MAIL_OUTBOX_PURGE_DAYS=30
ACCOUNT_RECOVERY_PURGE_DAYS=90
OPERATIONAL_METRICS_PURGE_DAYS=30
PRIVACY_REQUEST_PURGE_DAYS=1095
AUDIT_PURGE_DAYS=365
ANALYTICS_RETENTION_DAYS=180
HOUSEKEEPING_INTERVAL_MINUTES=60

AUTH_LIMIT=10
REGISTER_LIMIT=10
LINK_CREATE_LIMIT=30
RESOLVE_LIMIT=600
API_TOKEN_LIMIT=600
# Crea un sitekey exclusivo para app.uvh.es y activa su allowlist de dominio.
# El secreto sólo se configura en el backend; nunca se expone al navegador.
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=
# Credencial/sitekey distinto, permitido exclusivamente para uvh.es.
HCAPTCHA_PUBLIC_SITE_KEY=
HCAPTCHA_PUBLIC_SECRET=
HCAPTCHA_CONNECT_TIMEOUT=2
HCAPTCHA_TIMEOUT=5
# Startup and runtime guards forbid the local fallback in production.
HCAPTCHA_DEV_FALLBACK=false

# Feed JSON HTTPS de un monitor realmente externo al despliegue UVH. El token
# es sólo de lectura y nunca se expone a /status ni al navegador.
PUBLIC_STATUS_FEED_URL=
PUBLIC_STATUS_FEED_BEARER=
PUBLIC_STATUS_CONNECT_TIMEOUT_SECONDS=2
PUBLIC_STATUS_TIMEOUT_SECONDS=4
PUBLIC_STATUS_MAX_AGE_SECONDS=300
